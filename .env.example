# Copy to .env and adjust. .env is gitignored (brief rule 5).
OLLAMA_HOST=http://127.0.0.1:11434
# Set these as USER environment variables before starting `ollama serve`.
# Three, not two: the pipeline needs the generator, the embedder AND the
# rewriter resident at once. With two slots, measured, every turn evicted
# and reloaded a model twice (see plan 11.2).
#   OLLAMA_MAX_LOADED_MODELS=3
#   OLLAMA_NUM_PARALLEL=1
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
DEV_LLM_MODEL=qwen3:1.7b-q4_K_M
EMBED_MODEL=bge-m3
ALT_EMBED_MODEL=nomic-embed-text
NUM_THREAD=8
